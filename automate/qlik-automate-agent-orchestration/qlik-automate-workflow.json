    {
      "id": "4AA97F86-B00A-4DE0-A0DE-DF728BEDC7F5",
      "type": "EndpointBlock",
      "disabled": false,
      "name": "runFreshnessCheck",
      "displayName": "Snowflake - Do Query",
      "comment": "Select your Snowflake connection in this block's settings. Runs RUN_FRESHNESS_CHECK, which calls the Cortex Agent, writes the audit row and returns one row (STATUS, TABLES_BREACHED, ALERT_MESSAGE, RELOAD_NEEDED, ...). The loop below runs once for that row. Allow a long query timeout: agent runs can take a minute or more.",
      "childId": null,
      "inputs": [
        {
          "id": "e2f01500-bb27-11ec-9281-334a4766bfad",
          "value": "CALL {$.vAgentSchema}.RUN_FRESHNESS_CHECK('{$.vAgentSchema}.{$.vAgentName}', '{$.vTargetSchema}', {$.vSlaHours})",
          "type": "string",
          "structure": {}
        }
      ],
